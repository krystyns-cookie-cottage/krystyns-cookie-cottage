{
  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow"
  },
  "routes": [
    {
      "route": "/*.md",
      "statusCode": 404
    },
    {
      "route": "/apps-script/*",
      "statusCode": 404
    },
    {
      "route": "/netlify.toml",
      "statusCode": 404
    },
    {
      "route": "/",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/events.csv",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/config.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}